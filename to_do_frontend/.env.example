# Frontend environment configuration example for the To‑Do app

# PUBLIC_INTERFACE
# REACT_APP_API_BASE is the preferred base URL for the backend API.
# It should point to the backend server root; the app will call `${REACT_APP_API_BASE}/api/...`
REACT_APP_API_BASE=http://localhost:4000

# Optional fallback if REACT_APP_API_BASE is not set
REACT_APP_BACKEND_URL=http://localhost:4000

# Frontend app URL (used by other parts or for documentation)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional websocket URL if realtime is added later
REACT_APP_WS_URL=

# Environment flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info

# Healthcheck path for frontend (purely informational here)
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags (JSON or comma-separated list)
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
